generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  // Bumped on password change / "log out everywhere"; JWTs carry it as `tv`.
  tokenVersion  Int            @default(0)
  name          String
  // UI preference kept on the account, so light/dark follows the user to every
  // device and survives logging out and in. null = never chosen on an account
  // yet: the browser's own choice stands and is adopted on first load.
  theme         String?
  roleId        Int
  personId      Int?           @unique
  createdAt     DateTime       @default(now())
  person        Person?        @relation(fields: [personId], references: [id])
  roleRel       Role           @relation(fields: [roleId], references: [id])
  calendarFeeds CalendarFeed[]
  notesCreated  Note[]         @relation("NoteCreatedBy")
  notesUpdated  Note[]         @relation("NoteUpdatedBy")
}

model CalendarFeed {
  id        Int      @id @default(autoincrement())
  // Exactly one of userId/personId is set: a "company" feed belongs to
  // the user who issued it, a "person" feed to the person whose bookings
  // it lists — the latter needs no user account at all. Both columns are
  // nullable so the two unique constraints below can coexist (NULLs are
  // distinct in Postgres and SQLite alike).
  userId    Int?
  personId  Int?
  kind      String // "person" | "company"
  token     String   @unique
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@unique([personId])
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  label       String
  isSystem    Boolean          @default(false)
  scope       String           @default("all")
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id     Int    @id @default(autoincrement())
  roleId Int
  module String
  access String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

model Client {
  id            Int                  @id @default(autoincrement())
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  postalCode    String?
  city          String?
  vatNumber     String?
  notes         String?
  projects      Project[]
  functionRates ClientFunctionRate[]
  invoices      Invoice[]
  clientNotes   Note[]
}

model Location {
  id         Int       @id @default(autoincrement())
  name       String
  address    String?
  postalCode String?
  city       String?
  phone      String?
  notes      String?
  projects   Project[]
}

model Function {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  dayRate     Float?
  hourRate    Float?
  archived    Boolean              @default(false)
  people      PersonFunction[]
  assignments PeriodPerson[]
  clientRates ClientFunctionRate[]
}

model PersonFunction {
  personId   Int
  functionId Int
  dayRate    Float?
  hourRate   Float?
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@id([personId, functionId])
}

model ClientFunctionRate {
  id         Int      @id @default(autoincrement())
  clientId   Int
  functionId Int
  dayRate    Float?
  hourRate   Float?
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([clientId, functionId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  prefix    String
  materials Material[]
}

model Setting {
  key   String  @id
  value String?
  blob  Bytes?
}

model Project {
  id             Int                    @id @default(autoincrement())
  name           String
  client         String?
  clientId       Int?
  location       String?
  locationId     Int?
  startDate      DateTime
  endDate        DateTime
  status         String                 @default("concept")
  notes          String?
  createdAt      DateTime               @default(now())
  clientRel      Client?                @relation(fields: [clientId], references: [id])
  locationRel    Location?              @relation(fields: [locationId], references: [id])
  periods        Period[]
  materialPrices ProjectMaterialPrice[]
  personPrices   ProjectPersonPrice[]
  invoices       Invoice[]
  projectNotes   Note[]
}

model ProjectMaterialPrice {
  id         Int      @id @default(autoincrement())
  projectId  Int
  materialId Int
  dayPrice   Float
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([projectId, materialId])
}

model ProjectPersonPrice {
  id        Int     @id @default(autoincrement())
  projectId Int
  personId  Int
  dayPrice  Float
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([projectId, personId])
}

model Period {
  id             Int                      @id @default(autoincrement())
  projectId      Int
  name           String
  startDate      DateTime
  endDate        DateTime
  updatedAt      DateTime                 @default(now()) @updatedAt
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materials      PeriodStockItem[]
  people         PeriodPerson[]
  bundleBookings PeriodBundleBooking[]
  shortages      PeriodMaterialShortage[]
}

model Person {
  id              Int                  @id @default(autoincrement())
  name            String
  email           String?
  phone           String?
  address         String?
  postalCode      String?
  city            String?
  country         String?
  dayPrice        Float                @default(0)
  periods         PeriodPerson[]
  projectPrices   ProjectPersonPrice[]
  functions       PersonFunction[]
  userAccount     User?
  noteAssignments NoteAssignee[]
  calendarFeeds   CalendarFeed[]
  documents       PersonDocument[]
}

// C3 — a company you rent material from when you don't have it in stock
// (Funrent, Rent-men…). Separate from Client: a supplier is someone you pay.
model Supplier {
  id          Int     @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  postalCode  String?
  city        String?
  vatNumber   String?
  notes       String?
  archived    Boolean @default(false)

  materials Material[]
  shortages PeriodMaterialShortage[]
}

model Material {
  id                   Int                            @id @default(autoincrement())
  name                 String
  category             String?
  categoryId           Int?
  code                 String?                        @unique
  notes                String?
  dayPrice             Float                          @default(0)
  setupCost            Float?
  isBundle             Boolean                        @default(false)
  bundlePriceOverride  Float?
  archived             Boolean                        @default(false)
  costPrice            Float?
  listPrice            Float?
  revenueBefore        Float?
  // C3 — hiring in. `subhireUnitCost` is the supplier's default price per unit
  // (per rental or per day, see `subhireCostBasis`); `subhireOnly` marks
  // catalogue items you never stock (they are always rented in).
  defaultSupplierId    Int?
  subhireUnitCost      Float?
  subhireCostBasis     String                         @default("per_huur")
  subhireOnly          Boolean                        @default(false)
  defaultSupplier      Supplier?                      @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  categoryRel          Category?                      @relation(fields: [categoryId], references: [id])
  stockItems           StockItem[]
  projectPrices        ProjectMaterialPrice[]
  components           MaterialComponent[]            @relation("BundleParent")
  usedInBundles        MaterialComponent[]            @relation("BundleChild")
  bundleBookings       PeriodBundleBooking[]
  bundleBookingWeights PeriodBundleBookingComponent[]
  shortages            PeriodMaterialShortage[]
}

model StockItem {
  id          Int               @id @default(autoincrement())
  materialId  Int
  unitNumber  Int
  identifier  String?
  notes       String?
  costPrice   Float?
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assignments PeriodStockItem[]

  @@unique([materialId, unitNumber])
}

model PersonDocument {
  id        Int       @id @default(autoincrement())
  personId  Int
  filename  String
  label     String?
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PeriodStockItem {
  id                Int                  @id @default(autoincrement())
  periodId          Int
  stockItemId       Int
  dayPriceSnapshot  Float
  setupCostSnapshot Float                @default(0)
  discountPct       Float?
  discountAmount    Float?
  bundleBookingId   Int?
  shippedAt         DateTime?
  returnedAt        DateTime?
  period            Period               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  stockItem         StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  bundleBooking     PeriodBundleBooking? @relation(fields: [bundleBookingId], references: [id], onDelete: Cascade)

  @@unique([periodId, stockItemId])
}

model MaterialComponent {
  id       Int      @id @default(autoincrement())
  parentId Int
  childId  Int
  quantity Int      @default(1)
  parent   Material @relation("BundleParent", fields: [parentId], references: [id], onDelete: Cascade)
  child    Material @relation("BundleChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model PeriodBundleBooking {
  id               Int                            @id @default(autoincrement())
  periodId         Int
  materialId       Int
  quantity         Int                            @default(1)
  dayPriceSnapshot Float
  period           Period                         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  material         Material                       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  stockItems       PeriodStockItem[]
  components       PeriodBundleBookingComponent[]
  shortages        PeriodMaterialShortage[]
}

// DDL-3 — mirrors schema.prisma's PeriodBundleBookingComponent
// (Decimal -> Float, dev-only).
model PeriodBundleBookingComponent {
  id                Int                 @id @default(autoincrement())
  bundleBookingId   Int
  materialId        Int
  quantity          Int
  dayPriceAtBooking Float
  bundleBooking     PeriodBundleBooking @relation(fields: [bundleBookingId], references: [id], onDelete: Cascade)
  material          Material            @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([bundleBookingId])
}

// Overboeken (K-series) — mirrors schema.prisma's PeriodMaterialShortage
// (Decimal -> Float, dev-only). Records units of a material a period
// wants but that don't physically exist as a PeriodStockItem: either flat
// quantity booked beyond free stock, or (when bundleBookingId is set) a
// component shortfall inside a set booking.
model PeriodMaterialShortage {
  id                  Int                  @id @default(autoincrement())
  periodId            Int
  materialId          Int
  quantity            Int
  bundleBookingId     Int?
  dayPriceSnapshot    Float                @default(0)
  setupCostSnapshot   Float                @default(0)
  discountPct         Float?
  discountAmount      Float?
  // C3 — a shortage resolved by hiring the units in (`supplierId` set) is no
  // longer open: it stops blocking confirmation/invoicing and stays billed to
  // the client as normal material. Purchase cost: `subhireUnitCost` per unit
  // per rental, or per unit per day (`per_dag`), unless `subhireCostOverride`
  // fixes the row's total (supplier discount, transport).
  supplierId          Int?
  subhireCostBasis    String?
  subhireUnitCost     Float?
  subhireCostOverride Float?
  subhiredAt          DateTime?
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  period              Period               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  material            Material             @relation(fields: [materialId], references: [id], onDelete: Cascade)
  bundleBooking       PeriodBundleBooking? @relation(fields: [bundleBookingId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([supplierId])
}

model PeriodPerson {
  id               Int                @id @default(autoincrement())
  periodId         Int
  personId         Int
  functionId       Int?
  startAt          DateTime?
  endAt            DateTime?
  overlapAck       Boolean            @default(false)
  billingUnit      String             @default("dag")
  rateSnapshot     Float?
  dayPriceSnapshot Float
  discountPct      Float?
  discountAmount   Float?
  period           Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  person           Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  function         Function?          @relation(fields: [functionId], references: [id])
  travelCosts      PersonTravelCost[]
  days             PeriodPersonDay[]

  @@unique([periodId, personId])
}

/// H6 — a person booked for specific days of a period instead of the
/// whole run. Zero rows keeps the pre-H6 meaning exactly: the
/// assignment covers `startAt`/`endAt` when set, else the whole period.
/// When rows exist, `PeriodPerson.startAt`/`endAt` are maintained as
/// their envelope (earliest start, latest end) so every consumer that
/// only knows about the single window — the planning board, the ICS
/// feed, the availability pre-filter — keeps working unchanged.
model PeriodPersonDay {
  id             Int          @id @default(autoincrement())
  periodPersonId Int
  startAt        DateTime
  endAt          DateTime
  periodPerson   PeriodPerson @relation(fields: [periodPersonId], references: [id], onDelete: Cascade)

  @@index([periodPersonId])
}

model PersonTravelCost {
  id             Int          @id @default(autoincrement())
  periodPersonId Int
  label          String?
  unitCost       Float
  quantity       Int          @default(1)
  periodPerson   PeriodPerson @relation(fields: [periodPersonId], references: [id], onDelete: Cascade)
}

// DDL-3 — invoice models, mirroring schema.prisma's Invoice/InvoiceLine/
// Payment/InvoiceCounter field-for-field (Decimal -> Float, dev-only).
model Invoice {
  id                Int       @id @default(autoincrement())
  kind              String    @default("invoice")
  series            String    @default("invoice")
  status            String    @default("concept")
  invoiceRole       String    @default("standalone")
  number            String?
  year              Int?
  projectId         Int?
  clientId          Int
  creditNoteOfId    Int?
  // C1b — a replacement invoice created by "Corrigeren" points at the sent
  // invoice it replaces (which was credited in full in the same step).
  correctionOfId    Int?
  clientName        String
  clientAddress     String?
  clientPostalCode  String?
  clientCity        String?
  clientVatNumber   String?
  invoiceDate       DateTime?
  dueDate           DateTime?
  paymentReference  String?
  currency          String    @default("EUR")
  subtotalExcl      Float     @default(0)
  travelExcl        Float     @default(0)
  deductionExcl     Float     @default(0)
  vatAmount         Float     @default(0)
  totalIncl         Float     @default(0)
  depositType       String?
  depositPercentage Float?
  depositBasisExcl  Float?
  notes             String?
  footer            String?
  // C1 — draft-only inputs. `paymentTermDays` overrides the BTW/payment-term
  // setting for this one invoice (finalize derives dueDate from it);
  // `generatedHash` fingerprints the line generator's output at the moment
  // the draft was generated, so a later project change can be detected.
  paymentTermDays   Int?
  generatedHash     String?
  // C2 — quotes are Invoice rows with kind "offerte" (own number series).
  // `validUntil` is set when the quote is sent, `acceptedAt` when it is
  // accepted; an invoice made from a quote points back via `sourceQuoteId`.
  validUntil        DateTime?
  acceptedAt        DateTime?
  sourceQuoteId     Int?
  createdAt         DateTime  @default(now())
  finalizedAt       DateTime?

  client       Client        @relation(fields: [clientId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  creditNoteOf Invoice?      @relation("CreditNoteOf", fields: [creditNoteOfId], references: [id])
  creditNotes  Invoice[]     @relation("CreditNoteOf")
  correctionOf Invoice?      @relation("CorrectionOf", fields: [correctionOfId], references: [id])
  corrections  Invoice[]     @relation("CorrectionOf")
  sourceQuote  Invoice?      @relation("QuoteSource", fields: [sourceQuoteId], references: [id])
  fromQuote    Invoice[]     @relation("QuoteSource")
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([creditNoteOfId])
  @@index([correctionOfId])
  @@index([sourceQuoteId])
}

model InvoiceLine {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  section       String?
  kind          String
  description   String
  quantity      Float
  unit          String
  unitPrice     Float
  vatRate       Float
  lineTotalExcl Float
  sortOrder     Int
  sourceKind    String?
  sourceId      Int?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  amount    Float
  paidAt    DateTime
  method    String?
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceCounter {
  series  String
  year    Int
  lastSeq Int    @default(0)

  @@id([series, year])
}

// P3.3 — written inside the same transaction as a committed import
// apply (update or replace); a row only exists for imports that
// actually landed, never for a preview or a refused replace.
model ImportAudit {
  id        Int      @id @default(autoincrement())
  entity    String
  mode      String // "update" | "replace"
  userId    Int
  fileName  String
  rowCounts Json
  blockedBy Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

// Mirrors schema.prisma's Note/NoteImage field-for-field (dev-only, no
// Decimal fields to swap here).
model Note {
  id            Int      @id @default(autoincrement())
  title         String
  body          String
  noteDate      DateTime @default(now())
  projectId     Int?
  clientId      Int?
  createdById   Int?
  createdByName String
  updatedById   Int?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("NoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  images    NoteImage[]
  assignees NoteAssignee[]

  @@index([projectId])
  @@index([clientId])
  @@index([noteDate])
}

// C4 — who a note is for. Assigned to Persons (crew), not Users: a person
// without a login can still be assigned, and a user finds "their" notes
// through User.personId. `doneAt` is per assignee ("2/3 afgewerkt").
// Deleting a person (a hard delete today) drops their assignment with it.
model NoteAssignee {
  noteId   Int
  personId Int
  doneAt   DateTime?

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([noteId, personId])
  @@index([personId])
}

model NoteImage {
  id        Int      @id @default(autoincrement())
  noteId    Int
  filename  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}
