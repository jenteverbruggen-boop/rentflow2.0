generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PLANNER")
  roleId    Int?
  personId  Int?     @unique
  createdAt DateTime @default(now())
  person    Person?  @relation(fields: [personId], references: [id])
  roleRel   Role?    @relation(fields: [roleId], references: [id])
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  label       String
  isSystem    Boolean          @default(false)
  scope       String           @default("all")
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id     Int    @id @default(autoincrement())
  roleId Int
  module String
  access String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  postalCode  String?
  city        String?
  vatNumber   String?
  notes       String?
  projects    Project[]
}

model Location {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  postalCode String?
  city       String?
  phone      String?
  notes      String?
  projects   Project[]
}

model Function {
  id     Int              @id @default(autoincrement())
  name   String           @unique
  people PersonFunction[]
}

model PersonFunction {
  personId   Int
  functionId Int
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@id([personId, functionId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  prefix    String
  materials Material[]
}

model Setting {
  key   String  @id
  value String?
  blob  Bytes?
}

model Project {
  id             Int                    @id @default(autoincrement())
  name           String
  client         String?
  clientId       Int?
  location       String?
  locationId     Int?
  startDate      DateTime
  endDate        DateTime
  status         String                 @default("concept")
  notes          String?
  createdAt      DateTime               @default(now())
  clientRel      Client?                @relation(fields: [clientId], references: [id])
  locationRel    Location?              @relation(fields: [locationId], references: [id])
  periods        Period[]
  materialPrices ProjectMaterialPrice[]
  personPrices   ProjectPersonPrice[]
}

model ProjectMaterialPrice {
  id         Int      @id @default(autoincrement())
  projectId  Int
  materialId Int
  dayPrice   Float
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([projectId, materialId])
}

model ProjectPersonPrice {
  id        Int     @id @default(autoincrement())
  projectId Int
  personId  Int
  dayPrice  Float
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([projectId, personId])
}

model Period {
  id             Int                   @id @default(autoincrement())
  projectId      Int
  name           String
  startDate      DateTime
  endDate        DateTime
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materials      PeriodStockItem[]
  people         PeriodPerson[]
  bundleBookings PeriodBundleBooking[]
}

model Person {
  id            Int                  @id @default(autoincrement())
  name          String
  role          String?
  email         String?
  phone         String?
  address       String?
  postalCode    String?
  city          String?
  country       String?
  dayPrice      Float                @default(0)
  periods       PeriodPerson[]
  projectPrices ProjectPersonPrice[]
  functions     PersonFunction[]
  userAccount   User?
  documents     PersonDocument[]
}

model Material {
  id                  Int                    @id @default(autoincrement())
  name                String
  category            String?
  categoryId          Int?
  code                String?                @unique
  notes               String?
  dayPrice            Float                  @default(0)
  setupCost           Float?
  isBundle            Boolean                @default(false)
  bundlePriceOverride Float?
  categoryRel         Category?              @relation(fields: [categoryId], references: [id])
  stockItems          StockItem[]
  projectPrices       ProjectMaterialPrice[]
  components          MaterialComponent[]    @relation("BundleParent")
  usedInBundles       MaterialComponent[]    @relation("BundleChild")
  bundleBookings      PeriodBundleBooking[]
}

model StockItem {
  id          Int               @id @default(autoincrement())
  materialId  Int
  unitNumber  Int
  identifier  String?
  notes       String?
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assignments PeriodStockItem[]

  @@unique([materialId, unitNumber])
}

model PersonDocument {
  id        Int       @id @default(autoincrement())
  personId  Int
  filename  String
  label     String?
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PeriodStockItem {
  id               Int                  @id @default(autoincrement())
  periodId          Int
  stockItemId       Int
  dayPriceSnapshot  Float
  setupCostSnapshot Float                @default(0)
  discountPct       Float?
  discountAmount    Float?
  bundleBookingId   Int?
  period           Period               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  stockItem        StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  bundleBooking    PeriodBundleBooking? @relation(fields: [bundleBookingId], references: [id], onDelete: Cascade)

  @@unique([periodId, stockItemId])
}

model MaterialComponent {
  id       Int      @id @default(autoincrement())
  parentId Int
  childId  Int
  quantity Int      @default(1)
  parent   Material @relation("BundleParent", fields: [parentId], references: [id], onDelete: Cascade)
  child    Material @relation("BundleChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model PeriodBundleBooking {
  id               Int             @id @default(autoincrement())
  periodId         Int
  materialId       Int
  quantity         Int             @default(1)
  dayPriceSnapshot Float
  period           Period          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  material         Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  stockItems       PeriodStockItem[]
}

model PeriodPerson {
  id               Int                @id @default(autoincrement())
  periodId         Int
  personId         Int
  role             String?
  dayPriceSnapshot Float
  discountPct      Float?
  discountAmount   Float?
  period           Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  person           Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  travelCosts      PersonTravelCost[]

  @@unique([periodId, personId])
}

model PersonTravelCost {
  id             Int          @id @default(autoincrement())
  periodPersonId Int
  label          String?
  unitCost       Float
  quantity       Int          @default(1)
  periodPerson   PeriodPerson @relation(fields: [periodPersonId], references: [id], onDelete: Cascade)
}
